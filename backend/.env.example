# Backend Environment Variables
APP_NAME="Intelligent P2P Edge Backend"
APP_VERSION="0.1.0"
APP_ENV="development"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
HOST="127.0.0.1"
PORT=8000

# Supabase PostgreSQL Database & Authentication Configuration
# Provide these variables in your ignored local .env to enable Supabase persistence and auth.
# If omitted, the backend falls back safely to an in-memory development repository.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-if-using-symmetric-hs256"

# WebRTC & Signaling Configuration (Phase 4.4)
# Comma-separated public STUN servers for NAT discovery
WEBRTC_STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
# Optional TURN server configuration for symmetric NAT traversal
# WARNING: Never commit real production TURN credentials to source control!
WEBRTC_TURN_URLS=""
WEBRTC_TURN_USERNAME=""
WEBRTC_TURN_CREDENTIAL=""
SIGNALING_TICKET_TTL_SECONDS=60
SIGNALING_MAX_MESSAGE_BYTES=65536
SIGNALING_MAX_PEERS_PER_SESSION=16
SIGNALING_RATE_LIMIT_PER_MINUTE=120
